# --------------------------------------------------------------------------
# the step runner, executed inside the tmux session
# --------------------------------------------------------------------------

def tree(root, skip):
    out = {}
    for dp, dns, fns in os.walk(root):
        dns[:] = [d for d in dns if os.path.join(dp, d) not in skip and d != ".git"]
        for f in fns:
            p = os.path.join(dp, f)
            try:
                st = os.lstat(p)
                out[p] = (st.st_size, st.st_mtime_ns)
            except OSError:
                pass
    return out


def snapshot(skip):
    s = tree(str(CO), skip)
    s.update({"cache:" + k: v for k, v in tree(str(REAL_CACHE), set()).items()}
             if REAL_CACHE.is_dir() else {})
    return s


def run_step(stepdir, n, timeout):
    """Run step n inside the session; write out/err/rc/stray, then .done."""
    d = Path(stepdir)
    spec = json.loads((d / f"{n}.json").read_text())
    skip = {str(CO / "plan"), spec["evidence"]}
    print(f"$ {spec['cmd']}", flush=True)
    before = snapshot(skip)
    t = time.time()
    try:
        p = subprocess.run(["sh", "-c", spec["cmd"]], capture_output=True,
                           text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        rc, out, err, hung = p.returncode, p.stdout, p.stderr, False
    except subprocess.TimeoutExpired as e:
        def text(b):
            return b.decode(errors="replace") if isinstance(b, bytes) else (b or "")
        rc, out, err, hung = 124, text(e.stdout), text(e.stderr), True
    after = snapshot(skip)
    stray = sorted(k for k in after if before.get(k) != after[k])
    stray += sorted(k for k in before if k not in after)
    (d / f"{n}.out").write_text(out)
    (d / f"{n}.err").write_text(err)
    (d / f"{n}.res").write_text(json.dumps(
        {"rc": rc, "hung": hung, "dur": round(time.time() - t, 3), "stray": stray}))
    sys.stdout.write(out)
    sys.stderr.write(err)
    print(f"[step {n} rc={rc}]", flush=True)
    (d / f"{n}.done").touch()


# --------------------------------------------------------------------------
# sessions
# --------------------------------------------------------------------------

class Run:
    """One harness run: a private tmux socket, a run dir, a stub server.
    Everything it starts is recorded here and torn down by `close`."""

    def __init__(self, evidence, timeout):
        self.evidence = Path(evidence)
        self.evidence.mkdir(parents=True, exist_ok=True)
        self.timeout = timeout
        tag = hashlib.sha1(str(CO).encode()).hexdigest()[:8]
        self.socket = f"scholia-verify-{tag}-{os.getpid()}"
        self.root = Path(tempfile.mkdtemp(prefix="scholia-verify-"))
        self.stub = None
        self.stub_url = None
        self.sessions = []

    def tmux(self, *args, check=True):
        return subprocess.run(["tmux", "-L", self.socket, *args], check=check,
                              capture_output=True, text=True)

    def session(self, name, work):
        home = self.root / name / "home"
        block = self.root / name / "block" / "fastembed"
        for p in (home / ".local/bin", block, self.root / name / "tmp", work):
            p.mkdir(parents=True, exist_ok=True)
        for b in ("scholia", "scholia-eval"):
            link = home / ".local/bin" / b
            if not link.exists():
                link.symlink_to(BIN / b)
        (block / "__init__.py").write_text(
            'raise ImportError("fastembed blocked by verify: no model downloads")\n')
        env = {"HOME": str(home), "TMPDIR": str(self.root / name / "tmp") + "/",
               "PATH": f"{home}/.local/bin:" + os.environ.get("PATH", "/usr/bin:/bin"),
               "PYTHONPATH": str(block.parent), "PYTHONDONTWRITEBYTECODE": "1",
               "LANG": "en_US.UTF-8", "TERM": "xterm-256color",
               "SEED": str(SEED), "CO": str(CO), "PS1": "verify$ "}
        envargs = [f"{k}={v}" for k, v in env.items()]
        self.tmux("new-session", "-d", "-s", name, "-x", "200", "-y", "50",
                  "-c", str(work), "env", "-i", *envargs, "sh")
        self.sessions.append(name)
        if not getattr(self, "socket_path", None):
            self.socket_path = self.tmux("display-message", "-p", "-t", name,
                                         "#{socket_path}").stdout.strip()
        log = self.evidence / f"{name}.transcript.log"
        self.tmux("pipe-pane", "-t", name, "-o", f"cat >> '{log}'")
        return name

    def start_stub(self):
        code = r'''
import http.server, sys
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def go(self, body):
        codes = {"/ok": 200, "/gone": 404, "/forbidden": 403, "/boom": 500,
                 "/nohead": 405 if self.command == "HEAD" else 200}
        self.send_response(codes.get(self.path, 404))
        self.send_header("Content-Length", "2"); self.end_headers()
        if body: self.wfile.write(b"ok")
    def do_HEAD(self): self.go(False)
    def do_GET(self): self.go(True)
s = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)
print(s.server_address[1], flush=True)
s.serve_forever()
'''
        self.stub = subprocess.Popen([sys.executable, "-c", code],
                                     stdout=subprocess.PIPE, text=True)
        port = self.stub.stdout.readline().strip()
        if not port.isdigit():
            raise SystemExit("verify: the linkcheck stub server did not start")
        self.stub_url = f"http://127.0.0.1:{port}"
        (self.evidence / "stub.pid").write_text(str(self.stub.pid))

    def drive(self, name, n, spec, stepdir):
        spec = dict(spec, evidence=str(self.evidence))
        if self.stub_url:
            spec["cmd"] = spec["cmd"].replace("{S}", self.stub_url)
        (stepdir / f"{n}.json").write_text(json.dumps(spec))
        line = (f"{sys.executable} '{Path(__file__).resolve()}' _step "
                f"'{stepdir}' {n} {self.timeout}")
        self.tmux("send-keys", "-t", name, "-l", line)
        self.tmux("send-keys", "-t", name, "Enter")
        deadline = time.time() + self.timeout + 15
        done = stepdir / f"{n}.done"
        while not done.exists():  # a condition with a deadline, not a sleep
            if time.time() > deadline:
                return None
            time.sleep(0.05)
        return json.loads((stepdir / f"{n}.res").read_text())

    def close(self):
        for s in self.sessions:
            self.tmux("kill-session", "-t", s, check=False)
        self.tmux("kill-server", check=False)  # our private socket only
        sp = getattr(self, "socket_path", "")
        if sp and Path(sp).name == self.socket and Path(sp).is_socket():
            Path(sp).unlink()  # tmux can leave the socket file behind
        if self.stub and self.stub.poll() is None:
            self.stub.terminate()
            try:
                self.stub.wait(5)
            except subprocess.TimeoutExpired:
                self.stub.kill()
        subprocess.run(["chmod", "-R", "u+rwx", str(self.root)], capture_output=True)
        shutil.rmtree(self.root, ignore_errors=True)


def check(spec, res, out, err):
    """The invariant breaches and expectation misses for one step."""
    fails, leads = [], []
    if res is None:
        return ["INV-HANG (driver deadline)"], leads
    text = out + err
    if res["hung"]:
        fails.append("INV-HANG")
    if CRASH.search(err):
        fails.append("INV-CRASH")
    rc, want = res["rc"], spec["rc"]
    if want == 0 and rc != 0:
        fails.append(f"INV-EXIT (rc {rc}, want 0)")
    elif want == "nonzero" and rc == 0:
        fails.append("INV-EXIT (rc 0, want non-zero)")
    elif isinstance(want, int) and want != 0 and rc != want:
        fails.append(f"INV-EXIT (rc {rc}, want {want})")
    if rc != 0 and not err.strip() and not out.strip():
        fails.append("INV-EXIT (failed silently)")
    if not text.strip():
        leads.append("INV-SILENT")
    if res["stray"]:
        fails.append(f"INV-STRAY {res['stray'][:3]}")
    for w in spec["want"]:
        if w not in text:
            fails.append(f"missing {w!r}")
    for w in spec["deny"]:
        if w in text:
            fails.append(f"unexpected {w!r}")
    return fails, leads


def verify(names, args):
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    evidence = Path(args.evidence or HERE / ".evidence" / stamp)
    run = Run(evidence, args.timeout)
    results = []

    def stop(signum, frame):
        run.close()
        sys.exit(130)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    try:
        if "linkcheck" in names:
            run.start_stub()
        for feat in names:
            title, steps = SPEC[feat]
            work = run.root / feat / "work"
            stepdir = evidence / feat
            stepdir.mkdir(parents=True, exist_ok=True)
            main = run.session(f"{feat}-1", work)
            fresh_n = 0
            print(f"== {feat}: {title}")
            for i, spec in enumerate(steps, 1):
                name = main
                if spec["fresh"]:
                    fresh_n += 1
                    name = run.session(f"{feat}-fresh{fresh_n}", work)
                res = run.drive(name, i, spec, stepdir)
                out = (stepdir / f"{i}.out").read_text() if res else ""
                err = (stepdir / f"{i}.err").read_text() if res else ""
                fails, leads = check(spec, res, out, err)
                mark = "FAIL" if fails else "ok  "
                print(f"  {mark} {i:2d}. {spec['say']}"
                      + (f"  [{'; '.join(fails + leads)}]" if fails or leads else ""))
                results.append({"feature": feat, "step": i, "say": spec["say"],
                                "cmd": spec["cmd"], "rc": res and res["rc"],
                                "fails": fails, "leads": leads})
                if spec["fresh"]:
                    run.tmux("kill-session", "-t", name, check=False)
                    run.sessions.remove(name)
            run.tmux("kill-session", "-t", main, check=False)
            run.sessions.remove(main)
    finally:
        run.close()
    failed = [r for r in results if r["fails"]]
    summary = {"result": "fail" if failed else "pass", "features": names,
               "steps": len(results), "failed": len(failed),
               "silent_leads": sum(1 for r in results if r["leads"]),
               "evidence": str(evidence)}
    (evidence / "summary.json").write_text(json.dumps(
        {"summary": summary, "steps": results}, indent=1))
    print("VERIFY " + json.dumps(summary))
    return 1 if failed else 0


