CRASH = re.compile(r"Traceback \(most recent call last\)|^\w+(Error|Exception):", re.M)


# --------------------------------------------------------------------------
# features: each is a list of steps. A step is a dict:
#   cmd     shell command, run in the drive's work dir (seed copied there)
#   rc      expected exit: 0, "nonzero", or an int
#   want    substrings that must appear in stdout+stderr
#   deny    substrings that must not appear
#   say     what the user does, as prose (goes to the action log)
#   fresh   True: run in a second, fresh tmux session (INV-DURABLE)
# {S} in a cmd is the stub server's base URL (linkcheck only).
# --------------------------------------------------------------------------

def step(say, cmd, rc=0, want=(), deny=(), fresh=False):
    return {"say": say, "cmd": cmd, "rc": rc, "want": list(want),
            "deny": list(deny), "fresh": fresh}


