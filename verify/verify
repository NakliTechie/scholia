def doctor(args):
    problems, facts = [], []

    def need(ok, fact, fix):
        (facts if ok else problems).append(fact if ok else f"{fact} -- {fix}")

    need(sys.version_info >= (3, 11), f"python {sys.version.split()[0]}",
         "scholia needs Python 3.11+ (tomllib)")
    try:
        sqlite3.connect(":memory:").execute("CREATE VIRTUAL TABLE t USING fts5(x)")
        need(True, "sqlite has FTS5", "")
    except sqlite3.Error:
        need(False, "sqlite has no FTS5", "use a Python whose sqlite3 has FTS5")
    need(shutil.which("tmux") is not None, "tmux on PATH",
         "install tmux; every drive runs in its own tmux session")
    need(shutil.which("git") is not None, "git on PATH", "install git (template copy uses git archive)")
    for b in ("scholia", "scholia-eval"):
        p = BIN / b
        need(p.is_file() and os.access(p, os.X_OK), f"{p} is this checkout's and executable",
             f"chmod +x {p}")
    h = hashlib.sha1((BIN / "scholia").read_bytes()).hexdigest()[:12]
    head = subprocess.run(["git", "-C", str(CO), "rev-parse", "--short", "HEAD"],
                          capture_output=True, text=True).stdout.strip()
    dirty = subprocess.run(["git", "-C", str(CO), "status", "--porcelain", "--", "bin"],
                           capture_output=True, text=True).stdout.strip()
    facts.append(f"checkout {CO} @ {head or '?'}{' (bin/ modified)' if dirty else ''}; "
                 f"bin/scholia sha1 {h}")
    for rel in ("vault/sources", "vault/notes", "vault/eval/queries.tsv",
                "projects", "plan-history/history.md"):
        need((SEED / rel).exists(), f"seed demo/seed/{rel}", "restore demo/seed/ from git")
    facts.append(f"{sum(len(s) for _, s in SPEC.values())} steps in {len(SPEC)} features")
    missing = [f for f in SPEC if not (FEATURES / f"{f}.md").is_file()]
    need(not missing, "every feature has a verify/features/<name>.md",
         f"write {', '.join(missing)}")
    if os.environ.get("SCHOLIA_VAULT"):
        facts.append(f"SCHOLIA_VAULT is set in your shell ({os.environ['SCHOLIA_VAULT']}); "
                     "drives unset it, so it is never touched")
    tmpdir = Path(tempfile.gettempdir())
    old = sorted(p.name for p in tmpdir.glob("scholia-verify-*"))
    if old:
        facts.append(f"{len(old)} scholia-verify-* run dir(s) in {tmpdir} from interrupted "
                     f"runs (not this run's; delete by name if unwanted): {', '.join(old[:5])}")
    try:
        probe = HERE / ".evidence"
        probe.mkdir(exist_ok=True)
        need(os.access(probe, os.W_OK), f"evidence dir {probe} writable", "fix its permissions")
    except OSError as e:
        need(False, "evidence dir", str(e))
    for f in facts:
        print(f"  ok   {f}")
    for p in problems:
        print(f"  FIX  {p}")
    ok = not problems
    print("DOCTOR " + json.dumps({"result": "ok" if ok else "fix", "problems": len(problems)}))
    return 0 if ok else 1


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "_step":  # internal: inside tmux
        run_step(sys.argv[2], sys.argv[3], float(sys.argv[4]))
        return 0
    p = argparse.ArgumentParser(
        prog="verify/verify", description=__doc__.split("\n\n")[0],
        epilog="Feature areas: " + ", ".join(SPEC) + ". Evidence goes to "
               "--evidence DIR (default verify/.evidence/<UTC stamp>/), never deleted.",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("doctor", help="preflight; says what to fix")
    sub.add_parser("list", help="feature areas in sweep order")
    v = sub.add_parser("verify", help="drive one feature, or all")
    v.add_argument("feature", nargs="?", help="one of: " + ", ".join(SPEC))
    v.add_argument("--evidence", metavar="DIR", help="where proof is kept")
    v.add_argument("--timeout", type=float, default=30.0,
                   help="seconds per command before INV-HANG (default 30)")
    args = p.parse_args()
    if args.cmd == "doctor":
        return doctor(args)
    if args.cmd == "list":
        for k, (title, steps) in SPEC.items():
            print(f"  {k:<13} {len(steps):2d} steps  {title}")
        return 0
    if args.feature and args.feature not in SPEC:
        print(f"verify: unknown feature {args.feature!r}; run `verify/verify list`",
              file=sys.stderr)
        return 2
    if shutil.which("tmux") is None:
        print("verify: tmux not found; run `verify/verify doctor`", file=sys.stderr)
        return 2
    return verify([args.feature] if args.feature else list(SPEC), args)


if __name__ == "__main__":
    sys.exit(main())
